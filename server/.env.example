# ---------- server ----------
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# ---------- mysql ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gold_finance
DB_POOL_SIZE=20

# ---------- auth ----------
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ---------- first admin (used by db:seed only) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123

# ---------- files ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
