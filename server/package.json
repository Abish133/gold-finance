{
  "name": "gold-finance-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Gold loan / pawn broking management - REST API",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "node src/db/migrate.js && node src/db/seed.js",
    "db:reset": "node src/db/reset.js --yes && node src/db/migrate.js && node src/db/seed.js",
    "test": "node test/run-all.mjs",
    "db:demo": "node src/db/seed-demo.js"
  },
  "imports": {
    "#config/*": "./src/config/*",
    "#db/*": "./src/db/*",
    "#middleware/*": "./src/middleware/*",
    "#utils/*": "./src/utils/*",
    "#services/*": "./src/services/*",
    "#modules/*": "./src/modules/*"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  }
}
